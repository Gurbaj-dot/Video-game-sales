import pandas as pd
import numpy as np

# Load data
df = pd.read_csv("/content/vgchartz-2024[1].csv")
df = df.dropna(subset=['console','genre','total_sales'])

# Group by Console + Genre → total sales & count
cross = df.groupby(['console','genre']).agg(
    sales=('total_sales','sum'),
    games=('title','count')
).reset_index()

# Calculate % share of each genre per platform
platform_totals = cross.groupby('console')['sales'].transform('sum')
cross['genre_pct_on_platform'] = cross['sales'] / platform_totals * 100

# Also calculate platform's share within each genre
genre_totals = cross.groupby('genre')['sales'].transform('sum')
cross['platform_pct_of_genre'] = cross['sales'] / genre_totals * 100

# Filter to meaningful platforms (≥ 50 games)
platform_game_counts = cross.groupby('console')['games'].sum()
major_platforms = platform_game_counts[platform_game_counts >= 50].index
major = cross[cross['console'].isin(major_platforms)]

# Find top genre per platform
top_per_platform = major.loc[major.groupby('console')['sales'].idxmax()].sort_values('sales', ascending=False)

print("🏆 TOP GENRE BY CONSOLE (by Sales %):")
display(top_per_platform[['console','genre','sales','genre_pct_on_platform']].round(1))

# Show strong specializations
threshold = 30  # >30% of platform's sales from ONE genre
specialized = major[major['genre_pct_on_platform'] > threshold].sort_values('genre_pct_on_platform', ascending=False)
print("\n⚡ STRONG GENRE SPECIALIZATIONS (>30% of platform sales):")


