# 1. Total Sales by Genre
genre_sales = data.groupby('genre')['total_sales'].sum().sort_values(ascending=False).reset_index()
genre_sales.columns = ['Genre', 'Total_Sales']

# 2. Top 10 Best-Selling Games Ever
top_games = data.sort_values('total_sales', ascending=False).head(10)

# 3. Sales Trend by Year
yearly_sales = data.groupby('Year')['total_sales'].sum().reset_index()

# 4. Sales by Console / Platform
console_sales = data.groupby('console')['total_sales'].sum().sort_values(ascending=False).head(15).reset_index()
console_sales.columns = ['Console', 'Total_Sales']

# 5. Regional Sales Breakdown
regional_totals = pd.Series({
    'North America': data['na_sales'].sum(),
    'Japan': data['jp_sales'].sum(),
    'Europe / PAL': data['pal_sales'].sum(),
    'Other': data['other_sales'].sum()
}).reset_index()
regional_totals.columns = ['Region', 'Sales']

# 6. Sales by Publisher (Top 10)
publisher_sales = data.groupby('publisher')['total_sales'].sum().sort_values(ascending=False).head(10).reset_index()
publisher_sales.columns = ['Publisher', 'Total_Sales']

