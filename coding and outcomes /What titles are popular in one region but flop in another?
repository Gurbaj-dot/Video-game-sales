import pandas as pd
import numpy as np

# Load and prepare data
df = pd.read_csv("/content/vgchartz-2024[1].csv")

# Drop rows missing key regional data
df = df.dropna(subset=['title','na_sales','jp_sales','pal_sales','total_sales'])

# Calculate percentage share per region
df['na_pct'] = df['na_sales'] / df['total_sales'] * 100
df['jp_pct'] = df['jp_sales'] / df['total_sales'] * 100
df['pal_pct'] = df['pal_sales'] / df['total_sales'] * 100
df['other_pct'] = df['other_sales'] / df['total_sales'] * 100

# Only look at meaningful games (at least 1M sales)
meaningful = df[df['total_sales'] >= 1.0].copy()

# ----------------------------------------------------------------
# PATTERN 1: HUGE in North America, FLOP in Japan
# ----------------------------------------------------------------
us_hit_jp_flop = meaningful[
    (meaningful['na_pct'] >= 60) &
    (meaningful['jp_pct'] <= 5)
].sort_values('total_sales', ascending=False)

# ----------------------------------------------------------------
# PATTERN 2: HUGE in Japan, FLOP in North America
# ----------------------------------------------------------------
jp_hit_us_flop = meaningful[
    (meaningful['jp_pct'] >= 40) &
    (meaningful['na_pct'] <= 20)
].sort_values('jp_sales', ascending=False)

# ----------------------------------------------------------------
# PATTERN 3: HUGE in Europe/PAL, FLOP in Japan
# ----------------------------------------------------------------
eu_hit_jp_flop = meaningful[
    (meaningful['pal_pct'] >= 50) &
    (meaningful['jp_pct'] <= 5)
].sort_values('total_sales', ascending=False)

# ----------------------------------------------------------------
# Show results
# ----------------------------------------------------------------
def show_results(data, title):
    print(f"\n{'='*70}")
    print(f"  {title}")
    print(f"{'='*70}")
    display(data[['title','console','total_sales','na_pct','jp_pct','pal_pct']].round(1).head(15))

show_results(us_hit_jp_flop, "🏆 HUGE in NORTH AMERICA — FLOP in JAPAN")
show_results(jp_hit_us_flop, "🇯🇵 HUGE in JAPAN — FLOP in NORTH AMERICA")
show_results(eu_hit_jp_flop, "🇪🇺 HUGE in EUROPE — FLOP in JAPAN")

 
